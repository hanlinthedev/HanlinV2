# Optional Google Search Console HTML-tag verification token (not the full meta tag).
GOOGLE_SITE_VERIFICATION=

# Optional: set these after deploying the Express API to enable admin-managed content.
# Leave PORTFOLIO_CONTENT_API_URL unset to keep using the current local content files.
PORTFOLIO_CONTENT_API_URL=https://admin.hanlinaung.dev/api/public/content
REVALIDATE_SECRET=SET_THE_SAME_RANDOM_SECRET_ON_THE_API
